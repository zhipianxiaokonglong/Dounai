{
  "identifier": "default",
  "description": "Dounai 悬浮窗的最小权限集",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging"
  ]
}
